# Backend Server Environment Variables (NEVER place these in the Android APK)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Primary AI Provider (Groq - Answer Generation Only)
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI Embeddings (@cf/baai/bge-m3, 1024 dimensions)
# CLOUDFLARE_ACCOUNT_ID falls back to R2_ACCOUNT_ID if omitted
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-api-token

# Cloudflare R2 Private Object Storage (for official PDF binaries)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=indian-railway-rules-pdfs

# PDF Upload Limits (bytes, default 50 MB)
MAX_PDF_UPLOAD_BYTES=52428800
